# 33-document staging profile (isolated Neo4j on loopback port 17687)
VAT_ENV=staging
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vat-temporal-2026

VAT_CORPUS_PATH=data/processed/vat_corpus.staging.json
VAT_EMBEDDINGS_PATH=data/processed/article_embeddings.staging.json
VAT_EMBEDDING_META_PATH=data/processed/embedding_meta.staging.json
VAT_AMENDMENT_REVIEW_PATH=tests/fixtures/amendment_review.staging.json

EMBEDDING_PROVIDER=ollama
VECTOR_ENABLED=1

# Set LLM_PROVIDER=gemini with a valid GEMINI_API_KEY, or switch LLM_PROVIDER=ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
OLLAMA_NUM_CTX=8192
